{
  "name": "cankeceoglu-web",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*"]
  }
  // Add the D1 binding after creating the database (see README.md).
  // ,"d1_databases": [{"binding":"DB","database_name":"cankeceoglu-stats","database_id":"YOUR_DATABASE_ID"}]
}
