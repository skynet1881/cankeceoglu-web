{
  "name": "cankeceoglu-web",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cankeceoglu-stats",
      "database_id": "82ac3cd4-1c1c-4bf7-b42a-8847c86d4422"
    }
  ]
}
